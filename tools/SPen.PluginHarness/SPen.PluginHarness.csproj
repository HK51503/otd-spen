<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>spen-harness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin excludes OTD's runtime assets; the harness stands in for OTD, so it needs them. -->
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SPen.OpenTabletDriver\SPen.OpenTabletDriver.csproj" />
  </ItemGroup>

</Project>
